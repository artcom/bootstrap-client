{
  "name": "@artcom/bootstrap-client",
  "version": "8.0.0",
  "description": "A library which queries and processes bootstrap data from a bootstrap server.",
  "main": "./lib/main.js",
  "types": "./lib/main.d.ts",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "import": "./lib/main.js",
      "default": "./lib/main.js"
    }
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "format": "prettier --write src tests",
    "lint": "eslint src tests --fix",
    "test": "tsc -p tsconfig.test.json && tsx --import ./tests/silenceLogger.ts --test \"tests/**/*.test.ts\"",
    "build": "tsc",
    "build:watch": "tsc -w",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artcom/bootstrap-client.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@artcom/logger": "^1.6.0",
    "@artcom/mqtt-topping": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "license": "MIT",
  "keywords": [
    "bootstrap",
    "mqtt",
    "config"
  ]
}
